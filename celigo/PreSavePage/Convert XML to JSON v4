function preSavePage(options) {
  var inData = options.data || [];
  var outData = [];
  var mode = options.testMode === true;

  for (var i = 0; i < inData.length; i++) {
    var src = inData[i] || {};
    var xml = src.pXMLDoc;

    if (!xml || typeof xml !== "string" || !xml.trim()) {
      // Pass-through if no XML
      outData.push(src);
      continue;
    }

    try {
      // Parse shipments from XML (fast-path parser)
      var shipments = parseShipmentConfirmationAdviceXml(xml);

      for (var j = 0; j < shipments.length; j++) {
        var s = shipments[j] || {};

        // Trace key: DepositorCode-OrderRefNumber-ShipmentID
        s._traceKey = [
          safeStr(s.DepositorCode),
          safeStr(s.OrderRefNumber),
          safeStr(s.ShipmentID),
        ].join("-");
        
        // Master doc handling (S12929-style)
        if (s.__isMasterDocument === true) {
          s.isMasterShipment = true;
          s.__skipReason = "master_document_total_qty_0";
          s.load = {};               // keep output lean + traceable
          outData.push(s);
          continue;
        }
        
        s.isMasterShipment = false;

        // Build load object
        s.load = transform(s, mode);

        // Ensure XML blob is not carried forward
        if (s.pXMLDoc) delete s.pXMLDoc;

        // Optionally: if transform returns {}, you can skip pushing to reduce noise
        outData.push(s);
      }
    } catch (e) {
      outData.push({
        _traceKey: "xml-parse-failed",
        __xmlParseError: String(e && e.message ? e.message : e),
      });
    }
  }

  return {
    data: outData,
    errors: options.errors || [],
    abort: outData.length === 0, // abort if no output
    newErrorsAndRetryData: [],
  };
}

/**
 * transform(record, testMode)
 * ---------------------------
 * Builds a "load" object from a parsed shipment record.
 *
 * PERFORMANCE NOTES:
 * - Single pass over ShipLine to compute cargo_qty, cargo_weight, and max freight class.
 * - Avoid filter/map in hot paths; use classic loops for Celigo runtime stability.
 *
 * @param {Object} record Parsed shipment object
 * @param {boolean} testMode Warehouse ID mode toggle
 * @returns {Object} load payload or {} if insufficient data (ex: missing delivery location)
 */
function transform(record, testMode) {
  record.mode = testMode;

  var shipToCode = record && record.ShipTo ? record.ShipTo.ShipToCode : "";
  var shipDateYmd = safeDateToYmd(record.ShipDate);
  var expDateYmd = safeDateToYmd(record.ExpDeliveryDate);

  var load = {
    Reference: record.ShipmentID,
    DepositorCode: record.DepositorCode,
    OrderStatus: record.OrderStatus,
    shipmentType: "",
    cargo_qty: 0,
    cargo_weight: 0,
    serviceType: record.ShipmentMethodCode === "LTL" ? "LTL" : "dryvan",
    frclass: "",
    loadNos: {
      bill_of_lading_no: record.ShipmentID,
      load_no: record.OrderRefNumber,
      purchase_order_no: record.HdrUser1,
    },
    shipto: shipToCode,
    shipdate: shipDateYmd,
    deliveryDate: expDateYmd || "",
    locations: [], // filled below
  };

  // Add Uber Freight info if needed (kept behavior, simplified)
  if (record.DepositorCode === "CUR01") {
    var otherNos = null;
    if (record.HdrUser2) {
      otherNos = otherNos || [];
      otherNos.push({
        type: "other",
        number: record.HdrUser2,
        other: "Transplace Number",
      });
    }
    if (record.HdrUser3) {
      otherNos = otherNos || [];
      otherNos.push({
        type: "other",
        number: record.HdrUser3,
        other: "Uber Freight load Number",
      });
    }
    if (otherNos) load.loadNos.other = otherNos;
  }

  // Compute cargo + frclass in one pass
  var hasLines = false;
  var lines = record.ShipLine;

  if (lines) {
    if (!Array.isArray(lines)) lines = [lines];

    for (var i = 0; i < lines.length; i++) {
      var item = lines[i];
      if (!item) continue;
      hasLines = true;

      var qty = toNumber(item.QtyOrdered);
      var weight = toNumber(item.LGrsWeight);
      var fr = safeStr(item.FreightClass);

      // keep your rounding behavior
      load.cargo_qty += roundTo2(qty);
      load.cargo_weight += roundTo2(weight);

      // "max" freight class - compare as numbers when possible
      if (fr) {
        if (!load.frclass) {
          load.frclass = fr;
        } else if (toNumber(fr) > toNumber(load.frclass)) {
          load.frclass = fr;
        }
      }
    }
  }

  // Fallback if ShipLine missing/empty
  if (!hasLines) {
    load.cargo_qty = toNumber(record.TotalQtyOrdered);
    load.cargo_weight = toNumber(record.GrsWeight);
  }

  if (!isFinite(load.cargo_weight) || load.cargo_weight < 0) load.cargo_weight = 0;

  // Shipment type logic (kept)
  if (load.cargo_weight > 7000) {
    load.shipmentType = "TRUCKLOAD";
  } else {
    load.shipmentType = "LTL";
    if (!load.frclass) load.frclass = "50";
  }

  // Locations (avoid removeEmpty recursion; just omit empties directly)
  var pickup = createLocation(record, "pickup", 1);
  if (pickup) load.locations.push(pickup);

  var delivery = createLocation(record, "delivery", 2);
  if (delivery) load.locations.push(delivery);

  // Your existing rule: require a delivery (index 1 after pickup)
  return load.locations.length > 1 ? load : {};
}

function safeStr(v) {
  if (v === null || v === undefined) return "";
  return String(v).trim();
}

function toNumber(v) {
  var n = parseFloat(v);
  return isFinite(n) ? n : 0;
}

