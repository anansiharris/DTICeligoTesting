/* ===========================
   FAST XML string helpers
   =========================== */

/**
 * Returns inner text of <tag>...</tag> from within xmlFragment.
 * Handles namespaces like <ns:Tag> by matching optional "prefix:".
 */
function getTagText(xmlFragment, tagName) {
  if (!xmlFragment) return "";
  // match <Tag ...>text</Tag> OR <ns:Tag ...>text</ns:Tag>
  var open = new RegExp("<(?:[A-Za-z0-9_\\-]+:)?"+escapeRegExp(tagName)+"(?:\\s[^>]*)?>", "i");
  var close = new RegExp("</(?:[A-Za-z0-9_\\-]+:)?"+escapeRegExp(tagName)+"\\s*>", "i");

  var m1 = open.exec(xmlFragment);
  if (!m1) return "";
  var start = m1.index + m1[0].length;

  // find closing after start
  close.lastIndex = 0;
  var m2 = close.exec(xmlFragment.slice(start));
  if (!m2) return "";

  var raw = xmlFragment.slice(start, start + m2.index);
  return decodeEntities(raw).trim();
}

/** Slice the first <tag>...</tag> block inside fragment */
function sliceFirstBlock(fragment, tagName) {
  var blocks = sliceAllBlocks(fragment, tagName, 1);
  return blocks.length ? blocks[0] : "";
}

/**
 * Slice all <tag>...</tag> blocks in a string.
 * @param {string} xml
 * @param {string} tagName
 * @param {number} limit optional
 */
function sliceAllBlocks(xml, tagName, limit) {
  var out = [];
  if (!xml) return out;

  var openRe = new RegExp("<(?:[A-Za-z0-9_\\-]+:)?"+escapeRegExp(tagName)+"(?:\\s[^>]*)?>", "ig");
  var closeRe = new RegExp("</(?:[A-Za-z0-9_\\-]+:)?"+escapeRegExp(tagName)+"\\s*>", "ig");

  var openMatch;
  while ((openMatch = openRe.exec(xml)) !== null) {
    var startIdx = openMatch.index;
    var contentStart = startIdx;

    // find matching close tag after open
    closeRe.lastIndex = openRe.lastIndex;
    var closeMatch = closeRe.exec(xml);
    if (!closeMatch) break;

    var endIdx = closeMatch.index + closeMatch[0].length;
    out.push(xml.slice(contentStart, endIdx));

    if (limit && out.length >= limit) break;

    // continue after this block
    openRe.lastIndex = endIdx;
  }
  return out;
}

function decodeEntities(s) {
  return String(s || "")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'");
}

function escapeRegExp(s) {
  return String(s).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

/**
 * compactObject(obj)
 * ------------------
 * A lighter-weight alternative to your recursive removeEmpty().
 * Removes: null/undefined, "" (trim), and empty objects/arrays at the top level.
 * (We keep it shallow for speed; nested structures are already built compactly.)
 */
function compactObject(obj) {
  if (!obj || typeof obj !== "object") return obj;

  if (Array.isArray(obj)) {
    var a = [];
    for (var i = 0; i < obj.length; i++) {
      var v = obj[i];
      if (v === null || v === undefined) continue;
      if (typeof v === "string" && v.trim() === "") continue;
      if (typeof v === "object" && v && !Array.isArray(v) && Object.keys(v).length === 0) continue;
      if (Array.isArray(v) && v.length === 0) continue;
      a.push(v);
    }
    return a;
  }

  var out = {};
  for (var k in obj) {
    if (!Object.prototype.hasOwnProperty.call(obj, k)) continue;
    var v2 = obj[k];
    if (v2 === null || v2 === undefined) continue;
    if (typeof v2 === "string" && v2.trim() === "") continue;
    if (Array.isArray(v2) && v2.length === 0) continue;
    if (typeof v2 === "object" && v2 && !Array.isArray(v2) && Object.keys(v2).length === 0) continue;
    out[k] = v2;
  }
  return out;
}

