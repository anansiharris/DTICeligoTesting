// Creates a location object
function createLocation(record, type, order) {
  var isPickup = type === "pickup";
  var shipTo = record && record.ShipTo ? record.ShipTo : {};

  // If delivery and no ship-to address, return null quickly
  if (!isPickup && !safeStr(shipTo.ShipToAddr1)) return null;

