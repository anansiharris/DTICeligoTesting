function isString(value) {
  return typeof value === "string" || value instanceof String;
}

function roundTo2(n) {
  return Math.round((parseFloat(n) || 0) * 100) / 100;
}

/**
 * Convert "MM/DD/YYYY" -> "YYYYMMDD"
 * Returns "" if input is falsy or not parseable.
 */
function safeDateToYmd(d) {
  if (!d || typeof d !== "string") return "";
  d = d.trim();
  if (/^\d{8}$/.test(d)) return d; // already YYYYMMDD
  if (!/^\d{2}\/\d{2}\/\d{4}$/.test(d)) return "";
  var m = d.slice(0, 2);
  var day = d.slice(3, 5);
  var y = d.slice(6, 10);
  return y + m + day;
}

/** Ensure "MM/DD/YYYY" output */
function safeDateToMdY(d) {
  if (!d || typeof d !== "string") return "";
  d = d.trim();
  if (/^\d{2}\/\d{2}\/\d{4}$/.test(d)) return d;
  if (/^\d{8}$/.test(d)) {
    return d.slice(4, 6) + "/" + d.slice(6, 8) + "/" + d.slice(0, 4);
  }
  return "";
}

function mdYtoYmd(mdY) {
  // "MM/DD/YYYY" -> "YYYYMMDD"
  if (!/^\d{2}\/\d{2}\/\d{4}$/.test(mdY)) return "";
  return mdY.slice(6, 10) + mdY.slice(0, 2) + mdY.slice(3, 5);
}

function getTodayFormattedDate() {
  var d = new Date();
  return (
    String(d.getMonth() + 1).padStart(2, "0") +
    "/" +
    String(d.getDate()).padStart(2, "0") +
    "/" +
    d.getFullYear()
  );
}

function getDatePlusTwoDaysFrom(inputDate) {
  var year, month, day;

  if (/^\d{2}\/\d{2}\/\d{4}$/.test(inputDate)) {
    // Format: MM/DD/YYYY
    var parts = inputDate.split("/");
    month = Number(parts[0]);
    day = Number(parts[1]);
    year = Number(parts[2]);
  } else if (/^\d{8}$/.test(inputDate)) {
    // Format: YYYYMMDD
    year = Number(inputDate.substr(0, 4));
    month = Number(inputDate.substr(4, 2));
    day = Number(inputDate.substr(6, 2));
  } else {
    throw new Error("Unsupported date format: " + inputDate);
  }

  var date = new Date(year, month - 1, day);
  date.setDate(date.getDate() + 2);

  return (
    date.getFullYear() +
    String(date.getMonth() + 1).padStart(2, "0") +
    String(date.getDate()).padStart(2, "0")
  );
}
